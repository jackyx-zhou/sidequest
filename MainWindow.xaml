<Window x:Class="Sidequest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sidequest" Width="1280" Height="820" MinWidth="850" MinHeight="600"
        Background="{StaticResource WindowBrush}" Foreground="#F4F6F8"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
  <Grid x:Name="Root" Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="SIDEQUEST" FontSize="24" FontWeight="Bold" />
      <TextBlock Text="  Controller-friendly media browser" Foreground="{StaticResource MutedBrush}" FontSize="16" VerticalAlignment="Center" />
      <Button x:Name="RefreshDrivesButton" DockPanel.Dock="Right" Content="Refresh drives" Click="RefreshDrives_Click" Padding="12,7" FontSize="14" />
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="DrivePicker" Grid.Column="0" Width="145" Margin="0,0,10,0"
                Background="#E8EDF3" Foreground="#111827"
                SelectionChanged="DrivePicker_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding}" Foreground="#111827" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button x:Name="ParentButton" Grid.Column="1" Content="↑ Parent" Click="Parent_Click" Margin="0,0,10,0" />
      <Border Grid.Column="2" Background="#181D25" BorderBrush="#394351" BorderThickness="1" CornerRadius="8"
              Padding="12,9" Margin="0,0,10,0" VerticalAlignment="Stretch">
        <TextBlock x:Name="PathLabel" Foreground="#F4F6F8" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" ToolTip="Current folder path" />
      </Border>
      <Button x:Name="RefreshButton" Grid.Column="3" Content="Refresh" Click="Refresh_Click" Margin="0,0,0,0" MinWidth="96" />
    </Grid>

    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,12">
      <StackPanel x:Name="Breadcrumbs" Orientation="Horizontal" />
    </ScrollViewer>

    <ListBox x:Name="EntriesList" Grid.Row="3" ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0"
             SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
             SelectionChanged="EntriesList_SelectionChanged" MouseDoubleClick="EntriesList_MouseDoubleClick" KeyDown="EntriesList_KeyDown"
             SizeChanged="EntriesList_SizeChanged" FocusVisualStyle="{x:Null}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="Margin" Value="0,0,14,14" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="BorderThickness" Value="2" />
          <Setter Property="BorderBrush" Value="Transparent" />
          <Setter Property="Background" Value="#1B2029" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="VerticalContentAlignment" Value="Stretch" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="12">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="Card" Property="Background" Value="#263342" /></Trigger>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#252D39" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid Height="205">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#11151B" CornerRadius="9" Margin="0,0,0,9" ClipToBounds="True">
              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Grid.Row="1">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
              <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0">
                <Run Text="{Binding Extension, Mode=OneWay}" />
                <Run Text="  ·  " />
                <Run Text="{Binding Size, Mode=OneWay, StringFormat='{}{0:N0} bytes'}" />
              </TextBlock>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="StatusText" Text="Starting at C:\" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
      <ProgressBar x:Name="PreviewProgress" Grid.Column="1" Width="190" Height="12" Margin="16,0,10,0"
                   Minimum="0" Maximum="1" Visibility="Collapsed" VerticalAlignment="Center" />
      <TextBlock x:Name="PreviewProgressText" Grid.Column="2" Foreground="{StaticResource MutedBrush}" FontSize="13"
                 VerticalAlignment="Center" Margin="0,0,18,0" Visibility="Collapsed" />
      <TextBlock Grid.Column="3" Text="D-pad: browse / controls   A: select / play   B: back / quit at root   LB / RB: media   Ctrl+Q: quit"
                 Foreground="{StaticResource MutedBrush}" FontSize="13" VerticalAlignment="Center" />
    </Grid>

    <Grid x:Name="ViewerOverlay" Grid.RowSpan="5" Visibility="Collapsed" Background="#F20B0D12">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel x:Name="ViewerHeader" Grid.Row="0" Margin="10,0,10,12">
          <Button x:Name="ViewerBackButton" Content="← Back to files" Click="CloseViewer_Click" />
        <TextBlock x:Name="ViewerTitle" Foreground="#F4F6F8" FontSize="17" VerticalAlignment="Center" Margin="18,0,0,0" TextTrimming="CharacterEllipsis" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="PreviousButton" Content="‹ Previous" Click="Previous_Click" Margin="8,0,0,0" />
          <Button x:Name="NextButton" Content="Next ›" Click="Next_Click" Margin="8,0,0,0" />
          <Button x:Name="VideoOnlyButton" Content="Video fullscreen" Click="VideoOnly_Click" Margin="8,0,0,0" Visibility="Collapsed" />
          <Button x:Name="FullScreenButton" Content="Full screen" Click="FullScreen_Click" Margin="8,0,0,0" />
        </StackPanel>
      </DockPanel>
      <Grid Grid.Row="1">
        <Image x:Name="StillImage" Stretch="Uniform" Visibility="Collapsed" />
        <MediaElement x:Name="VideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" Visibility="Collapsed" MediaOpened="VideoPlayer_MediaOpened" MediaFailed="VideoPlayer_MediaFailed" />
        <TextBlock x:Name="ViewerMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CFD7E2" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="620" />
      </Grid>
      <Grid x:Name="ViewerFooter" Grid.Row="2" Margin="10,14,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="PlaybackTime" Grid.Column="0" Foreground="{StaticResource MutedBrush}"
                   VerticalAlignment="Center" Margin="0,0,14,0" />
        <Slider x:Name="PlaybackProgress" Grid.Column="1" Minimum="0" Maximum="1" Value="0"
                IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="0,0,12,0"
                Visibility="Collapsed" ValueChanged="PlaybackProgress_ValueChanged"
                PreviewMouseLeftButtonDown="PlaybackProgress_MouseDown"
                PreviewMouseLeftButtonUp="PlaybackProgress_MouseUp" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="PlayPauseButton" Content="▶ Play" Click="PlayPause_Click" Visibility="Collapsed" />
          <Button x:Name="SeekBackButton" Content="−10 sec" Click="SeekBack_Click" Margin="8,0,0,0" />
          <Button x:Name="SeekForwardButton" Content="+10 sec" Click="SeekForward_Click" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Grid>

    <Grid x:Name="QuitConfirmationOverlay" Grid.RowSpan="5" Visibility="Collapsed"
          Background="#D9000000" Panel.ZIndex="10" Focusable="True">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560"
              Background="{StaticResource PanelBrush}" BorderBrush="#536174" BorderThickness="2"
              CornerRadius="18" Padding="32">
        <StackPanel>
          <TextBlock Text="Quit Sidequest?" FontSize="28" FontWeight="Bold" />
          <TextBlock Text="Your files will not be changed." Foreground="{StaticResource MutedBrush}"
                     FontSize="17" Margin="0,10,0,26" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="KeepBrowsingButton" Content="Keep browsing" Click="KeepBrowsing_Click"
                    IsDefault="True" Margin="0,0,12,0" />
            <Button x:Name="QuitButton" Content="Quit Sidequest" Click="Quit_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
